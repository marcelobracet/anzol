# Studio (Cloudflare Access)
CF_ACCESS_TEAM_DOMAIN=https://SEU-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=
STUDIO_ALLOWED_EMAILS=voce@exemplo.com,socio@exemplo.com
# Só vale em localhost e previews; produção ignora.
AUTH_DEV_BYPASS_EMAIL=

# Roteamento
STUDIO_HOST=anzol.marcelobracet.com.br
BLOCKED_HOSTS=marcelobracet.com.br

# Supabase (service role, só servidor)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mídia
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Bunny Stream: pull zone da biblioteca (ex.: vz-abc123.b-cdn.net)
BUNNY_CDN_HOST=
# Cloudflare R2: vídeos da VSL (upload direto do Studio). Ver README > "Vídeo no R2".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domínio público do bucket, ex.: https://media.seudominio.com
R2_PUBLIC_BASE_URL=

# Vercel (cadastro automático de domínios de oferta)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Rastreamento (só servidor)
META_CAPI_TOKEN=
# Webhook da Hotmart (X-HOTMART-HOTTOK)
HOTMART_HOTTOK=
